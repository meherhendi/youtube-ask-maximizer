{
  "manifest_version": 3,
  "name": "Maximize \"Ask about this video\"",
  "version": "1.0.0",
  "description": "Adds a button to the YouTube \"Ask about this video\" panel that expands it to the full width of the browser window.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*",
        "https://m.youtube.com/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "styles.css"
      ],
      "run_at": "document_idle"
    }
  ]
}
